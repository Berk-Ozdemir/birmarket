# Demo mode is safe to run without external credentials or network services.
birmarket_demo_mode=true
birmarket_demo_sqlite_path=.data/birmarket-demo.sqlite3
birmarket_real_sqlite_path=.data/birmarket.sqlite3
birmarket_provider_environment=sandbox
birmarket_public_base_url=
birmarket_flat_shipping_fee=49
birmarket_free_shipping_threshold=1500

# Required only when birmarket_demo_mode=false.
birmarket_admin_email=
birmarket_admin_password=
birmarket_data_protection_key=

# iyzico merchant credentials.
iyzico_api_key=
iyzico_secret_key=

# PayTR merchant credentials.
paytr_merchant_id=
paytr_merchant_key=
paytr_merchant_salt=

# KargoJet credentials and default carrier.
kargojet_api_token=
kargojet_webhook_secret=
kargojet_carrier_code=aras

# Azure Communication Services SMTP settings.
smtp_host=smtp.azurecomm.net
smtp_port=587
smtp_username=
smtp_password=
email_from=
email_from_name=Birmarket
